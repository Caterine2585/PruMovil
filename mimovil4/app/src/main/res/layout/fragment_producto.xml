<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

    <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <EditText
                android:id="@+id/etID_Producto"
                android:hint="ID_Producto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        <EditText
                android:id="@+id/etNombre_Producto"
                android:hint="Nombre_Producto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        <EditText
                android:id="@+id/etDescripcion"
                android:hint="Descripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        <EditText
                android:id="@+id/etPrecio_Venta"
                android:hint="Precio_Venta"
                android:inputType="numberDecimal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        <EditText
                android:id="@+id/etStock_Minimo"
                android:hint="Stock_Minimo"
                android:inputType="number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        <EditText
                android:id="@+id/etID_Categoria"
                android:hint="ID_Categoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        <EditText
                android:id="@+id/etID_Estado"
                android:hint="ID_Estado (EST001)"
                android:text="EST001"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        <EditText
                android:id="@+id/etID_Gama"
                android:hint="ID_Gama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        <EditText
                android:id="@+id/etFotos"
                android:hint="Fotos (URL/ruta)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        <!-- Botón POST -->
        <Button
                android:id="@+id/btnCrearProducto"
                android:text="Crear Producto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

        <!-- Botón GET -->
        <Button
                android:id="@+id/btnGetProductos"
                android:text="Ver Productos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

        <!-- TextView para mostrar la lista -->
        <TextView
                android:id="@+id/tvProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Aquí se mostrarán los productos"
                android:textSize="14sp" />

    </LinearLayout>
</ScrollView>