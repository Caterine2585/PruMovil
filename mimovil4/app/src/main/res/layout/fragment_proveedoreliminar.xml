<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- SCROLL PARA EL FORMULARIO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:layout_above="@+id/btnOpciones">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- TÍTULO -->
            <TextView
                android:text="Eliminar Proveedor"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp" />

            <!-- ID PROVEEDOR -->
            <EditText
                android:id="@+id/etIdProveedorEliminar"
                android:hint="ID del proveedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- BOTÓN BUSCAR -->
            <Button
                android:id="@+id/btnBuscarProveedorEliminar"
                android:text="Buscar Proveedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp" />

            <!-- TEXTO RESULTADO -->
            <TextView
                android:id="@+id/tvResultadoProveedor"
                android:text="Ingrese un ID para buscar..."
                android:textSize="16sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp" />

            <!-- BOTÓN ELIMINAR -->
            <Button
                android:id="@+id/btnEliminarProveedor"
                android:text="Eliminar Proveedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp" />

        </LinearLayout>

    </ScrollView>

    <!-- BOTÓN OPCIONES ABAJO -->
    <ImageButton
        android:id="@+id/btnOpciones"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:src="@drawable/ic_suma"
        android:background="@android:color/transparent"
        android:padding="10dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true" />

</RelativeLayout>
