<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

    <!-- SCROLL PRINCIPAL -->
    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp"
            android:layout_above="@id/btnOpcionesempleado">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                    android:text="Actualizar Empleado"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp" />

            <!-- BUSCAR EMPLEADO -->
            <EditText
                    android:id="@+id/etBuscarDocumentoEmp"
                    android:hint="Documento del empleado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            <Button
                    android:id="@+id/btnBuscarEmp"
                    android:text="Buscar Empleado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp" />

            <!-- CAMPOS EDITABLES -->
            <EditText
                    android:id="@+id/etDocumentoEmp"
                    android:hint="Documento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            <EditText
                    android:id="@+id/etTipoDocEmp"
                    android:hint="Tipo de Documento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            <EditText
                    android:id="@+id/etNombreEmp"
                    android:hint="Nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            <EditText
                    android:id="@+id/etApellidoEmp"
                    android:hint="Apellido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            <EditText
                    android:id="@+id/etEdadEmp"
                    android:hint="Edad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            <EditText
                    android:id="@+id/etCorreoEmp"
                    android:hint="Correo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            <EditText
                    android:id="@+id/etTelefonoEmp"
                    android:hint="Teléfono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            <EditText
                    android:id="@+id/etGeneroEmp"
                    android:hint="F/M"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            <EditText
                    android:id="@+id/etEstadoEmp"
                    android:text="EST001"
                    android:hint="Estado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            <EditText
                    android:id="@+id/etRolEmp"
                    android:text="ROL001"
                    android:hint="Rol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            <!-- 🔐 CONTRASEÑA (NUEVO - opcional) -->
            <EditText
                    android:id="@+id/etContrasenaEmp"
                    android:hint="Nueva contraseña (opcional)"
                    android:inputType="textPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

            <!-- IMAGEN -->
            <ImageView
                    android:id="@+id/imgFotoEmp"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:contentDescription="Foto del empleado"
                    android:background="#EEEEEE"
                    android:scaleType="centerCrop" />

            <Button
                    android:id="@+id/btnSeleccionarFoto"
                    android:text="Seleccionar Foto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

            <!-- BOTÓN ACTUALIZAR -->
            <Button
                    android:id="@+id/btnActualizarEmpleado"
                    android:text="Actualizar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" />

        </LinearLayout>

    </ScrollView>

    <!-- BOTÓN FLOTANTE INFERIOR -->
    <ImageButton
            android:id="@+id/btnOpcionesempleado"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_suma"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true" />

</RelativeLayout>
